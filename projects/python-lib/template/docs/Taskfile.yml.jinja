---
# Docs module (Zensical). Expects PKG_DIR / PKG / PY from parent.
# https://taskfile.dev

version: "3"

vars:
  PKG_DIR: '{{ "{{" }}.PKG_DIR | default "src/{{ project_slug }}"{{ "}}" }}'
  PKG: '{{ "{{" }}.PKG | default .PKG_DIR{{ "}}" }}'
  PY: '{{ "{{" }}.PY | default "uv run"{{ "}}" }}'

tasks:

  list:
    desc: "Show available commands"
    aliases:
      - default
    silent: true
    cmds:
      - task --list

  test:
    desc: "Run documentation checks"
    cmds:
      - task: test_lint
      - task: build

  test_lint:
    desc: "Check markdown linting"
    cmds:
      - "{{ "{{" }}.PY{{ "}}" }} pymarkdownlnt scan $(git ls-files . | grep 'md$' || true)"

  build:
    desc: Build static site into site/
    cmds:
      - rm -rf .cache
      - "{{ "{{" }}.PY{{ "}}" }} zensical build -f mkdocs.yml"

  serve:
    desc: Preview docs at http://localhost:8089
    cmds:
      - rm -rf .cache
      - "{{ "{{" }}.PY{{ "}}" }} zensical serve -f mkdocs.yml"

  publish:
    desc: Build and deploy site/ to gh-pages
    cmds:
      - task: build
      - "{{ "{{" }}.PY{{ "}}" }} ghp-import -n -p -f site"
