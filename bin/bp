#!/usr/bin/env bash
# bp — boilerplate manager core CLI
set -euo pipefail

STATE_DIR=".bp"
DEFAULT_REPO="${BP_DEFAULT_REPO:-}"
YES=0
BP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
bp — boilerplate manager

Usage:
  bp add <repo> <part-path> [@ref] [-y]
  bp update <name> [-y]
  bp update --all [-y]
  bp remove <name> [-y]
  bp list
  bp browse <repo> [@ref]
  bp new <repo> <template-path> [@ref]
  bp menu
  bp help | --help | -h

Environment:
  BP_DEFAULT_REPO   Optional default repo URL (not required when repo is passed)

Dependencies: git (>= 2.25), jq. Copier required only for `bp new`.
EOF
}

die() { echo "error: $*" >&2; exit 1; }

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

# Parse a single scalar YAML key with optional yq, else grep/sed fallback.
yaml_get() {
  local file=$1 key=$2
  local val=""
  if command -v yq >/dev/null 2>&1; then
    val=$(yq -r ".$key // \"\"" "$file" 2>/dev/null || true)
  fi
  if [ -z "$val" ] || [ "$val" = "null" ]; then
    val=$(grep -E "^${key}:" "$file" 2>/dev/null | head -n1 | sed -E "s/^${key}:[[:space:]]*//" | sed -E 's/^["'\'']//;s/["'\'']$//' || true)
  fi
  if [ "$val" = "null" ] || [ "$val" = "~" ]; then
    val=""
  fi
  printf '%s' "$val"
}

confirm() {
  local prompt=$1
  if [ "$YES" -eq 1 ]; then
    return 0
  fi
  local ans
  read -r -p "$prompt [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

# Collect relative file paths under a directory (no trailing slashes).
list_files() {
  local root=$1
  (cd "$root" && find . -type f ! -name '.gitkeep' | sed 's|^\./||' | sort)
}

bp_fetch() {
  local repo=$1 path=$2 ref=${3:-main}
  local tmp
  tmp=$(mktemp -d)
  if ! git clone --quiet --depth 1 --filter=blob:none --sparse --branch "$ref" "$repo" "$tmp" >/dev/null 2>&1; then
    rm -rf "$tmp"
    die "failed to clone $repo (ref=$ref)"
  fi
  if ! git -C "$tmp" sparse-checkout set "$path" >/dev/null 2>&1; then
    rm -rf "$tmp"
    die "failed to sparse-checkout path '$path'"
  fi
  echo "$tmp"
}

bp_fetch_roots() {
  local repo=$1
  shift
  local ref=$1
  shift
  local tmp
  tmp=$(mktemp -d)
  if ! git clone --quiet --depth 1 --filter=blob:none --sparse --branch "$ref" "$repo" "$tmp" >/dev/null 2>&1; then
    rm -rf "$tmp"
    die "failed to clone $repo (ref=$ref)"
  fi
  if [ "$#" -gt 0 ]; then
    if ! git -C "$tmp" sparse-checkout set "$@" >/dev/null 2>&1; then
      rm -rf "$tmp"
      die "failed to sparse-checkout paths"
    fi
  fi
  echo "$tmp"
}

parse_ref() {
  # Strip leading @ from optional ref argument.
  local ref=${1:-main}
  ref=${ref#@}
  printf '%s' "$ref"
}

bp_add() {
  local repo=${1:-} path=${2:-} ref_raw=${3:-main}
  [ -n "$repo" ] || die "usage: bp add <repo> <part-path> [@ref]"
  [ -n "$path" ] || die "usage: bp add <repo> <part-path> [@ref]"
  path=${path#/}
  path=${path%/}
  local ref
  ref=$(parse_ref "$ref_raw")

  local tmp
  tmp=$(bp_fetch "$repo" "$path" "$ref")

  local part_dir="$tmp/$path"
  if [ ! -d "$part_dir/files" ]; then
    rm -rf "$tmp"
    die "$path has no files/ dir"
  fi

  local name
  name=$(basename "$path")
  if [ -f "$part_dir/part.yaml" ]; then
    local yaml_name
    yaml_name=$(yaml_get "$part_dir/part.yaml" "name")
    [ -n "$yaml_name" ] && name="$yaml_name"
  fi

  local meta="$STATE_DIR/$name.json"
  if [ -f "$meta" ] && [ "$YES" -ne 1 ]; then
    rm -rf "$tmp"
    die "part '$name' is already installed (use -y to overwrite)"
  fi

  local files=()
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    files+=("$f")
  done < <(list_files "$part_dir/files")
  if [ "${#files[@]}" -eq 0 ]; then
    rm -rf "$tmp"
    die "$path/files is empty"
  fi

  local conflicts=()
  for f in "${files[@]}"; do
    if [ -e "./$f" ] && [ "$YES" -ne 1 ]; then
      conflicts+=("$f")
    fi
  done
  if [ "${#conflicts[@]}" -gt 0 ]; then
    echo "error: refusing to overwrite existing files:" >&2
    printf '  %s\n' "${conflicts[@]}" >&2
    echo "hint: pass -y to force overwrite" >&2
    rm -rf "$tmp"
    exit 1
  fi

  for f in "${files[@]}"; do
    mkdir -p "$(dirname "./$f")"
    cp -f "$part_dir/files/$f" "./$f"
  done

  local sha
  sha=$(git -C "$tmp" rev-parse HEAD)
  mkdir -p "$STATE_DIR"

  local files_json
  files_json=$(printf '%s\n' "${files[@]}" | jq -R . | jq -s .)

  jq -n \
    --arg name "$name" \
    --arg repo "$repo" \
    --arg path "$path" \
    --arg ref "$ref" \
    --arg sha "$sha" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson installed_files "$files_json" \
    '{
      name: $name,
      repo: $repo,
      path: $path,
      ref: $ref,
      sha: $sha,
      installed_at: $ts,
      installed_files: $installed_files
    }' > "$meta"

  if [ -f "$part_dir/part.yaml" ]; then
    local post_add
    post_add=$(yaml_get "$part_dir/part.yaml" "post_add")
    if [ -n "$post_add" ]; then
      bash -c "$post_add"
    fi
  fi

  rm -rf "$tmp"
  echo "added '$name' from $repo:$path@$ref (${#files[@]} files)"
}

bp_update_one() {
  local name=$1
  local meta="$STATE_DIR/$name.json"
  [ -f "$meta" ] || die "no installed part named '$name'"

  local repo path ref
  repo=$(jq -r .repo "$meta")
  path=$(jq -r .path "$meta")
  ref=$(jq -r .ref "$meta")

  local tmp
  tmp=$(bp_fetch "$repo" "$path" "$ref")

  local part_dir="$tmp/$path"
  if [ ! -d "$part_dir/files" ]; then
    rm -rf "$tmp"
    die "$path has no files/ dir"
  fi

  echo "--- diff for $name ---"
  local old_files=()
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    old_files+=("$f")
  done < <(jq -r '.installed_files[]?' "$meta")

  local new_files=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    new_files+=("$f")
  done < <(list_files "$part_dir/files")

  local has_diff=0
  local tmp_old tmp_new
  tmp_old=$(mktemp -d)
  tmp_new=$(mktemp -d)
  if [ "${#old_files[@]}" -gt 0 ]; then
    for f in "${old_files[@]}"; do
      if [ -f "./$f" ]; then
        mkdir -p "$tmp_old/$(dirname "$f")"
        cp "./$f" "$tmp_old/$f"
      fi
    done
  fi
  for f in "${new_files[@]}"; do
    mkdir -p "$tmp_new/$(dirname "$f")"
    cp "$part_dir/files/$f" "$tmp_new/$f"
  done
  if ! diff -rq "$tmp_old" "$tmp_new" >/dev/null 2>&1; then
    has_diff=1
    diff -rq "$tmp_old" "$tmp_new" || true
  else
    echo "(no changes)"
  fi
  rm -rf "$tmp_old" "$tmp_new"

  if [ "$has_diff" -eq 0 ]; then
    local sha
    sha=$(git -C "$tmp" rev-parse HEAD)
    jq --arg sha "$sha" '.sha=$sha' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
    rm -rf "$tmp"
    echo "already up to date '$name' @ ${sha:0:8}"
    return 0
  fi

  if ! confirm "apply update for '$name'?"; then
    rm -rf "$tmp"
    echo "skipped"
    return 0
  fi

  if [ "${#old_files[@]}" -gt 0 ]; then
    for f in "${old_files[@]}"; do
      local still=0
      local n
      for n in "${new_files[@]}"; do
        if [ "$f" = "$n" ]; then still=1; break; fi
      done
      if [ "$still" -eq 0 ] && [ -e "./$f" ]; then
        rm -f "./$f"
        local d
        d=$(dirname "./$f")
        while [ "$d" != "." ] && [ -d "$d" ] && [ -z "$(ls -A "$d" 2>/dev/null)" ]; do
          rmdir "$d" 2>/dev/null || break
          d=$(dirname "$d")
        done
      fi
    done
  fi

  for f in "${new_files[@]}"; do
    mkdir -p "$(dirname "./$f")"
    cp -f "$part_dir/files/$f" "./$f"
  done

  local sha files_json
  sha=$(git -C "$tmp" rev-parse HEAD)
  files_json=$(printf '%s\n' "${new_files[@]}" | jq -R . | jq -s .)
  jq --arg sha "$sha" --argjson installed_files "$files_json" \
    '.sha=$sha | .installed_files=$installed_files' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
  rm -rf "$tmp"
  echo "updated '$name' -> ${sha:0:8}"
}

bp_update() {
  if [ "${1:-}" = "--all" ]; then
    [ -d "$STATE_DIR" ] || { echo "no parts installed"; return 0; }
    local any=0
    local f name
    for f in "$STATE_DIR"/*.json; do
      [ -e "$f" ] || continue
      any=1
      name=$(basename "$f" .json)
      bp_update_one "$name"
    done
    [ "$any" -eq 1 ] || echo "no parts installed"
    return 0
  fi
  local name=${1:-}
  [ -n "$name" ] || die "usage: bp update <name> | bp update --all"
  bp_update_one "$name"
}

bp_remove() {
  local name=${1:-}
  [ -n "$name" ] || die "usage: bp remove <name>"
  local meta="$STATE_DIR/$name.json"
  [ -f "$meta" ] || die "no installed part named '$name'"

  if ! confirm "remove part '$name'?"; then
    echo "skipped"
    return 0
  fi

  # Best-effort post_remove: re-fetch part.yaml if possible, else skip
  local repo path ref
  repo=$(jq -r .repo "$meta")
  path=$(jq -r .path "$meta")
  ref=$(jq -r .ref "$meta")
  local tmp=""
  if tmp=$(bp_fetch "$repo" "$path" "$ref" 2>/dev/null); then
    if [ -f "$tmp/$path/part.yaml" ]; then
      local post_remove
      post_remove=$(yaml_get "$tmp/$path/part.yaml" "post_remove")
      if [ -n "$post_remove" ]; then
        bash -c "$post_remove" || true
      fi
    fi
    rm -rf "$tmp"
  fi

  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -e "./$f" ]; then
      rm -f "./$f"
      local d
      d=$(dirname "./$f")
      while [ "$d" != "." ] && [ -d "$d" ] && [ -z "$(ls -A "$d" 2>/dev/null)" ]; do
        rmdir "$d" 2>/dev/null || break
        d=$(dirname "$d")
      done
    fi
  done < <(jq -r '.installed_files[]?' "$meta")

  rm -f "$meta"
  echo "removed '$name'"
}

bp_list() {
  if [ ! -d "$STATE_DIR" ] || [ -z "$(ls -A "$STATE_DIR" 2>/dev/null || true)" ]; then
    echo "no parts installed"
    return 0
  fi

  echo "installed parts:"
  local files=()
  local f
  for f in "$STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    files+=("$f")
  done

  local i=0
  local total=${#files[@]}
  for f in "${files[@]}"; do
    i=$((i + 1))
    local name sha ref path
    name=$(jq -r '.name // empty' "$f")
    [ -n "$name" ] || name=$(basename "$f" .json)
    sha=$(jq -r .sha "$f")
    ref=$(jq -r .ref "$f")
    path=$(jq -r .path "$f")
    local branch="├─"
    [ "$i" -eq "$total" ] && branch="└─"
    echo "  ${branch} ${name}  (${ref} @ ${sha:0:8})  [${path}]"
  done
}

bp_browse() {
  local repo=${1:-} ref_raw=${2:-main}
  [ -n "$repo" ] || die "usage: bp browse <repo> [@ref]"
  local ref
  ref=$(parse_ref "$ref_raw")

  local tmp
  tmp=$(bp_fetch_roots "$repo" "$ref" parts common templates)

  echo "parts:"
  if [ -d "$tmp/parts" ]; then
    find "$tmp/parts" -type f -name 'part.yaml' | sed "s|^$tmp/||" | sed 's|/part.yaml$||' | sort | while read -r p; do
      echo "  $p"
    done
  else
    echo "  (none)"
  fi

  echo "common:"
  if [ -d "$tmp/common" ]; then
    find "$tmp/common" -type f -name 'part.yaml' | sed "s|^$tmp/||" | sed 's|/part.yaml$||' | sort | while read -r p; do
      echo "  $p"
    done
  else
    echo "  (none)"
  fi

  echo "templates:"
  if [ -d "$tmp/templates" ]; then
    find "$tmp/templates" -mindepth 1 -maxdepth 1 -type d | sed "s|^$tmp/||" | sort | while read -r p; do
      echo "  $p"
    done
  else
    echo "  (none)"
  fi
  rm -rf "$tmp"
}

bp_new() {
  local repo=${1:-} template_path=${2:-} ref_raw=${3:-main}
  [ -n "$repo" ] || die "usage: bp new <repo> <template-path> [@ref]"
  [ -n "$template_path" ] || die "usage: bp new <repo> <template-path> [@ref]"
  local ref
  ref=$(parse_ref "$ref_raw")

  if ! command -v copier >/dev/null 2>&1; then
    cat >&2 <<'EOF'
error: copier is required for `bp new`
install: pipx install copier
     or: pip install copier
EOF
    exit 1
  fi

  # Copier can clone from VCS; pass path as subdirectory via src syntax.
  # Prefer: copier copy "gh:org/repo.git" with subdirectory, or local path.
  # Use: copier copy "$repo" . --vcs-ref "$ref" with template at subdirectory.
  # Official form for subpath: git+URL#subdirectory=path
  local src
  if [[ "$repo" == /* ]] || [[ "$repo" == ./* ]] || [[ "$repo" == ../* ]] || [[ "$repo" == file://* ]]; then
    # Local path: join with template path
    src="${repo%/}/$template_path"
    [ -d "$src" ] || die "template not found: $src"
    copier copy "$src" .
  else
    # Remote: use git+ URL with subdirectory fragment when possible
    src="git+${repo}@${ref}#subdirectory=${template_path}"
    copier copy "$src" .
  fi
}

bp_menu_bash_fallback() {
  local repo=${1:-$DEFAULT_REPO}
  [ -n "$repo" ] || {
    read -r -p "boilerplate repo URL/path: " repo
  }
  [ -n "$repo" ] || die "repo is required"

  echo "Fetching part list from $repo ..."
  local listing
  listing=$(bp_browse "$repo" | awk '
    /^parts:$/ {sec="parts"; next}
    /^common:$/ {sec="common"; next}
    /^templates:$/ {sec=""; next}
    /^  / && sec!="" && $0 !~ /\(none\)/ {gsub(/^  /,""); print}
  ')

  if [ -z "$listing" ]; then
    echo "no parts found"
    return 0
  fi

  local -a items=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    items+=("$line")
  done <<< "$listing"

  echo "Select a part (number), or q to quit:"
  local i=1
  for line in "${items[@]}"; do
    printf '  %2d) %s\n' "$i" "$line"
    i=$((i + 1))
  done
  local choice
  read -r -p "> " choice
  [[ "$choice" =~ ^[Qq]$ ]] && return 0
  [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid selection"
  [ "$choice" -ge 1 ] && [ "$choice" -le "${#items[@]}" ] || die "invalid selection"

  local selected="${items[$((choice - 1))]}"
  echo "Actions for $selected:"
  echo "  1) add"
  echo "  2) update (by part name)"
  echo "  3) remove (by part name)"
  local action
  read -r -p "> " action
  local pname
  pname=$(basename "$selected")
  case "$action" in
    1) bp_add "$repo" "$selected" ;;
    2) bp_update_one "$pname" ;;
    3) bp_remove "$pname" ;;
    *) die "invalid action" ;;
  esac
}

bp_menu() {
  local menu_py="$BP_ROOT/cli/bp_menu.py"
  if [ -f "$menu_py" ] && command -v python3 >/dev/null 2>&1; then
    if python3 -c "import questionary, rich" 2>/dev/null; then
      exec python3 "$menu_py" "$@"
    fi
  fi
  echo "note: Python menu unavailable (install: pip install -r cli/requirements.txt); using bash fallback" >&2
  bp_menu_bash_fallback "$@"
}

dispatch() {
  local cmd=${1:-}
  case "$cmd" in
    add)    shift; bp_add "$@";;
    update) shift; bp_update "$@";;
    remove) shift; bp_remove "$@";;
    list)   shift; bp_list "$@";;
    browse) shift; bp_browse "$@";;
    new)    shift; bp_new "$@";;
    menu)   shift; bp_menu "$@";;
    "" )    usage; exit 1;;
    *)      die "unknown command '$cmd' (try: bp --help)";;
  esac
}

main() {
  local -a args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes) YES=1; shift ;;
      -h|--help|help) usage; exit 0 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"

  require git
  require jq
  dispatch "$@"
}

main "$@"
